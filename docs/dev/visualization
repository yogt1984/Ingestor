    let chunks = Layout::default()
        .direction(Direction::Horizontal)
        .constraints([Constraint::Percentage(50), Constraint::Percentage(50)])
        .split(area);

    // TRADES
    let mom_color = if snap.momentum > 0.0 {
        Color::Green
    } else if snap.momentum < 0.0 {
        Color::Red
    } else {
        Color::Gray
    };

    let trade_lines = vec![
        Spans::from(vec![
            Span::styled("LAST ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.last_price)),
            Span::raw("  "),
            Span::styled("SIZE ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.last_size)),
        ]),
        Spans::from(vec![
            Span::styled("VWAP ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.vwap_tot)),
        ]),
        Spans::from(vec![
            Span::styled("MOM ", Style::default().fg(Color::Yellow)),
            Span::styled(format!("{:+.3}", snap.momentum), Style::default().fg(mom_color)),
            Span::raw("  "),
            Span::styled("RATE ", Style::default().fg(Color::Yellow)),
            Span::raw(format!("{:.1} /s", snap.trade_rate)),
        ]),
