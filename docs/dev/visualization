fn draw_title_bar<B: ratatui::backend::Backend>(
    f: &mut ratatui::Frame<B>,
    area: Rect,
    snap: &MetricsSnapshot,
) {
    let title = format!(
        " Ingestor — AVAXUSDT — {} — [q] quit ",
        snap.ts.with_timezone(&Utc).format("%Y-%m-%d %H:%M:%S UTC")
    );

    let block = Block::default()
        .borders(Borders::TOP)
        .title(Span::styled(
            title,
            Style::default()
                .fg(Color::Cyan)
                .add_modifier(Modifier::BOLD),
        ));

    // Use only the first line at the top as a minimalist header
    let header_area = Rect {
        x: area.x,
        y: area.y,
        width: area.width,
        height: 1,
    };
    f.render_widget(block, header_area);
}

fn draw_core_liquidity<B: ratatui::backend::Backend>(
    f: &mut ratatui::Frame<B>,
    area: Rect,
    snap: &MetricsSnapshot,
) {
    let chunks = Layout::default()
        .direction(Direction::Horizontal)
        .constraints([Constraint::Percentage(50), Constraint::Percentage(50)])
        .split(area);

    // CORE block
    let delta = snap.micro - snap.mid;
    let delta_color = if delta > 0.0 {
        Color::Green
    } else if delta < 0.0 {
        Color::Red
    } else {
        Color::Gray
    };

    let core_lines = vec![
        Spans::from(vec![
            Span::styled("MID ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.mid)),
            Span::raw("  "),
            Span::styled("MICRO ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.micro)),
        ]),
        Spans::from(vec![
            Span::styled("ΔMICRO-MID ", Style::default().fg(Color::Yellow)),
            Span::styled(format!("{:+.4}", delta), Style::default().fg(delta_color)),
            Span::raw("  "),
            Span::styled("SPRD ", Style::default().fg(Color::Magenta)),
            Span::raw(format!("{:.4}", snap.spread)),
        ]),
        Spans::from(vec![
            Span::styled("BID ", Style::default().fg(Color::Green)),
            Span::raw(format!("{:.4}", snap.bid)),
            Span::raw("  "),
            Span::styled("ASK ", Style::default().fg(Color::Red)),
            Span::raw(format!("{:.4}", snap.ask)),
        ]),
        Spans::from(vec![
            Span::styled("IMB ", Style::default().fg(Color::Yellow)),
            Span::raw(format!("{:.1}%", snap.imbalance * 100.0)),
        ]),
        Spans::from(vec![
            Span::styled("PWI ", Style::default().fg(Color::Blue)),
            Span::raw(format!(
                "1%={:+.2}% 5%={:+.2}% 25%={:+.2}% 50%={:+.2}%",
                snap.pwi_1 * 100.0,
                snap.pwi_5 * 100.0,
                snap.pwi_25 * 100.0,
                snap.pwi_50 * 100.0
            )),
        ]),
    ];

    let core = Paragraph::new(core_lines)
        .block(
            Block::default()
                .title(" CORE ")
                .borders(Borders::ALL),
        );
    f.render_widget(core, chunks[0]);

    // LIQUIDITY block
    let liq_lines = vec![
        Spans::from(vec![
            Span::styled("Roll ", Style::default().fg(Color::Gray)),
            Span::raw(format!("{:.6}", snap.roll)),
            Span::raw("  "),
            Span::styled("Amihud ", Style::default().fg(Color::Gray)),
            Span::raw(format!("{:.3e}", snap.amihud)),
        ]),
        Spans::from(vec![
            Span::styled("Kyle ", Style::default().fg(Color::Gray)),
            Span::raw(format!("{:.4}", snap.kyle)),
            Span::raw("  "),
            Span::styled("Hasbrouck ", Style::default().fg(Color::Gray)),
            Span::raw(format!("{:.4}", snap.hasbrouck)),
        ]),
        Spans::from(vec![
            Span::styled("VPIN ", Style::default().fg(Color::Magenta)),
            Span::raw(format!("{:.2}", snap.vpin)),
        ]),
    ];

    let liq = Paragraph::new(liq_lines)
        .block(
            Block::default()
                .title(" LIQUIDITY ")
                .borders(Borders::ALL),
        );
    f.render_widget(liq, chunks[1]);
}

fn draw_trades_flow<B: ratatui::backend::Backend>(
