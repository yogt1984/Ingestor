    // trades
    pub last_price: f64,
    pub last_size: f64,
    pub vwap_tot: f64,
    pub momentum: f64,
    pub trade_rate: f64, // trades/s

    // flow
    pub flow_imb: f64,
    pub flow_pressure: f64,
    pub flow_sig: bool,

    // entropy (7 scales each)
    pub tick_entropy: [f64; 7],
