    pub bid: f64,
    pub ask: f64,
    pub imbalance: f64,
    pub pwi_vec: Vec<(f64, f64)>, // (pct, value)
    pub tick_entropy: Vec<(String, f64)>,
    pub vol_entropy: Vec<(String, f64)>,
    pub vpin: f64,
    pub momentum: f64,
    pub trade_rate: f64,
    // etc...
}
c) Basic ratatui setup
use std::io;
use std::time::{Duration, Instant};

use crossterm::{
    event::{self, DisableMouseCapture, EnableMouseCapture, Event, KeyCode},
    execute,
    terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},
};
use ratatui::{
    backend::CrosstermBackend,
    Terminal,
    layout::{Constraint, Direction, Layout},
    widgets::{Block, Borders, Paragraph, Wrap, Sparkline},
    style::{Style, Color},
    text::{Span, Spans},
};

use crate::MetricsSnapshot;

pub fn run_tui<R>(rx: R) -> anyhow::Result<()>
where
    R: crossbeam_channel::Receiver<MetricsSnapshot>,
{
    enable_raw_mode()?;
    let mut stdout = io::stdout();
    execute!(stdout, EnterAlternateScreen, EnableMouseCapture)?;
    let backend = CrosstermBackend::new(stdout);
    let mut terminal = Terminal::new(backend)?;

    let res = ui_loop(&mut terminal, rx);

    disable_raw_mode()?;
    execute!(
        terminal.backend_mut(),
        LeaveAlternateScreen,
        DisableMouseCapture
    )?;
    terminal.show_cursor()?;

    res
}

fn ui_loop<R>(
    terminal: &mut Terminal<CrosstermBackend<std::io::Stdout>>,
    rx: R,
) -> anyhow::Result<()>
where
    R: crossbeam_channel::Receiver<MetricsSnapshot>,
{
    let mut last_snapshot = None;
    let mut last_redraw = Instant::now();

    loop {
        // non-blocking poll for keys
        if event::poll(Duration::from_millis(10))? {
            if let Event::Key(key) = event::read()? {
                if key.code == KeyCode::Char('q') {
                    break;
                }
            }
        }

        // grab latest snapshot (drain channel)
        while let Ok(snap) = rx.try_recv() {
            last_snapshot = Some(snap);
        }

        // redraw at ~10Hz
        if last_redraw.elapsed() >= Duration::from_millis(100) {
            terminal.draw(|f| {
                let size = f.size();

                let chunks = Layout::default()
                    .direction(Direction::Vertical)
                    .margin(1)
                    .constraints([
                        Constraint::Percentage(30), // core + liquidity
                        Constraint::Percentage(30), // trades + flow
                        Constraint::Percentage(40), // volume + entropy
                    ])
                    .split(size);

                if let Some(ref snap) = last_snapshot {
                    draw_core_and_liquidity(f, chunks[0], snap);
                    draw_trades_and_flow(f, chunks[1], snap);
                    draw_volume_and_entropy(f, chunks[2], snap);
                } else {
                    let block = Block::default()
                        .borders(Borders::ALL)
                        .title("Waiting for data...");
                    f.render_widget(block, chunks[0]);
                }
            })?;
            last_redraw = Instant::now();
        }
    }

    Ok(())
}
d) Example panel: CORE + LIQUIDITY
use ratatui::{
    Frame,
    layout::{Constraint, Direction, Layout, Rect},
    widgets::{Block, Borders, Paragraph},
    style::{Style, Color},
    text::{Span, Spans},
};

fn draw_core_and_liquidity<B: ratatui::backend::Backend>(
    f: &mut Frame<B>,
    area: Rect,
    snap: &MetricsSnapshot,
) {
    let chunks = Layout::default()
        .direction(Direction::Horizontal)
        .constraints([Constraint::Percentage(50), Constraint::Percentage(50)])
        .split(area);

    // CORE
    let delta = snap.micro - snap.mid;
    let delta_color = if delta > 0.0 { Color::Green } else if delta < 0.0 { Color::Red } else { Color::Gray };

    let core_lines = vec![
        Spans::from(vec![
            Span::styled("MID: ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.mid)),
            Span::raw("  "),
            Span::styled("MICRO: ", Style::default().fg(Color::Cyan)),
            Span::raw(format!("{:.4}", snap.micro)),
        ]),
        Spans::from(vec![
            Span::styled("ΔMICRO-MID: ", Style::default().fg(Color::Yellow)),
            Span::styled(format!("{:+.4}", delta), Style::default().fg(delta_color)),
            Span::raw("  "),
            Span::styled("SPRD: ", Style::default().fg(Color::Magenta)),
            Span::raw(format!("{:.4}", snap.spread)),
        ]),
        Spans::from(vec![
            Span::styled("BID/ASK: ", Style::default().fg(Color::Cyan)),
            Span::styled(format!("{:.4}", snap.bid), Style::default().fg(Color::Green)),
            Span::raw(" / "),
            Span::styled(format!("{:.4}", snap.ask), Style::default().fg(Color::Red)),
        ]),
        Spans::from(vec![
            Span::styled("IMB: ", Style::default().fg(Color::Yellow)),
            Span::raw(format!("{:.2}%", snap.imbalance * 100.0)),
        ]),
    ];

    let core_block = Paragraph::new(core_lines)
        .block(Block::default().title("CORE METRICS").borders(Borders::ALL));
    f.render_widget(core_block, chunks[0]);

    // LIQUIDITY
    let liq_lines = vec![
        Spans::from(vec![
            Span::styled("VPIN: ", Style::default().fg(Color::Magenta)),
            Span::raw(format!("{:.2}", snap.vpin)),
        ]),
        // Add Roll, Amihud, etc.
    ];

    let liq_block = Paragraph::new(liq_lines)
        .block(Block::default().title("LIQUIDITY").borders(Borders::ALL));
    f.render_widget(liq_block, chunks[1]);
}
e) Mini-charts: PWI or entropy as Sparkline
use ratatui::widgets::Sparkline;

fn draw_volume_and_entropy<B: ratatui::backend::Backend>(
    f: &mut Frame<B>,
    area: Rect,
    snap: &MetricsSnapshot,
) {
    let chunks = Layout::default()
        .direction(Direction::Horizontal)
        .constraints([Constraint::Percentage(50), Constraint::Percentage(50)])
        .split(area);

    // Left: PWI sparkline
    let pwi_values: Vec<i64> = snap
        .pwi_vec
        .iter()
        .map(|(_, v)| (v * 1000.0) as i64)
        .collect();

    let pwi_spark = Sparkline::default()
        .block(Block::default().title("PWI Sparkline").borders(Borders::ALL))
        .data(&pwi_values)
        .style(Style::default().fg(Color::Green));

    f.render_widget(pwi_spark, chunks[0]);

    // Right: entropy (as text or second sparkline)
    let ent_lines = snap
        .tick_entropy
        .iter()
        .map(|(label, val)| {
            Spans::from(vec![
                Span::styled(format!("{}: ", label), Style::default().fg(Color::Cyan)),
                Span::raw(format!("{:.4}", val)),
            ])
        })
        .collect::<Vec<_>>();

    let ent_block = Paragraph::new(ent_lines)
        .block(Block::default().title("ENTROPY").borders(Borders::ALL));

    f.render_widget(ent_block, chunks[1]);
}
