        ]),
    ];

    let flow = Paragraph::new(flow_lines)
        .block(
            Block::default()
                .title(" FLOW ")
                .borders(Borders::ALL),
        );
    f.render_widget(flow, chunks[1]);
}

fn draw_charts<B: ratatui::backend::Backend>(
    f: &mut ratatui::Frame<B>,
    area: Rect,
    snap: &MetricsSnapshot,
    mid_hist: &VecDeque<f64>,
    pwi_hist: &VecDeque<f64>,
    entropy_hist: &VecDeque<f64>,
) {
    let cols = Layout::default()
        .direction(Direction::Horizontal)
        .constraints([
            Constraint::Percentage(34),
            Constraint::Percentage(33),
            Constraint::Percentage(33),
        ])
        .split(area);

    // Helper: convert f64 hist to i64 for sparkline
    fn as_spark_data(buf: &VecDeque<f64>) -> Vec<i64> {
        if buf.is_empty() {
            return vec![];
        }
        let min = buf.iter().cloned().fold(f64::INFINITY, f64::min);
        let max = buf.iter().cloned().fold(f64::NEG_INFINITY, f64::max);
        let span = (max - min).max(1e-9);
        buf.iter()
            .map(|v| ((v - min) / span * 100.0) as i64)
            .collect()
    }

    // 1) MID price sparkline
    let mid_data = as_spark_data(mid_hist);
    let mid_spark = Sparkline::default()
        .block(
            Block::default()
                .title(Span::styled(
                    format!(" MID {:.4} ", snap.mid),
                    Style::default().fg(Color::Cyan),
                ))
                .borders(Borders::ALL),
        )
        .style(Style::default().fg(Color::Green))
        .data(&mid_data);
    f.render_widget(mid_spark, cols[0]);

    // 2) PWI 50% sparkline
    let pwi_data = as_spark_data(pwi_hist);
    let pwi_spark = Sparkline::default()
        .block(
            Block::default()
                .title(Span::styled(
                    format!(" PWI50 {:+.2}% ", snap.pwi_50 * 100.0),
                    Style::default().fg(Color::Blue),
                ))
                .borders(Borders::ALL),
        )
        .style(Style::default().fg(Color::Yellow))
        .data(&pwi_data);
    f.render_widget(pwi_spark, cols[1]);

    // 3) Entropy sparkline
    let entropy_data = as_spark_data(entropy_hist);
    let ent_spark = Sparkline::default()
        .block(
            Block::default()
                .title(Span::styled(
                    " TICK ENTROPY (1m) ",
                    Style::default().fg(Color::Magenta),
                ))
                .borders(Borders::ALL),
        )
        .style(Style::default().fg(Color::Magenta))
        .data(&entropy_data);
    f.render_widget(ent_spark, cols[2]);
}
