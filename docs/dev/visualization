mod metrics;
mod ui;

use crossbeam_channel::unbounded;
use metrics::MetricsSnapshot;

fn main() -> anyhow::Result<()> {
    let (tx, rx) = unbounded::<MetricsSnapshot>();

    // Spawn TUI in its own thread
    std::thread::spawn(move || {
        if let Err(e) = ui::run_tui(rx) {
            eprintln!("TUI error: {e:?}");
        }
    });

    // Your existing loop that computes metrics
    loop {
        let snap = compute_metrics_snapshot(); // <-- map from your current structs

        // non-blocking send; if UI closed, we just ignore
        let _ = tx.send(snap);

        // existing logic: logging/persistence/OMS etc.
    }
}

