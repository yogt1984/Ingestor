    algorithms/
      ├── core/
      │   ├── traits.rs       (Algorithm, Trainable, Configurable traits)
      │   ├── parameter.rs    (ParameterDefinition, SearchSpace)
      │   ├── registry.rs     (AlgorithmRegistry - discover all algos)
      │   └── factory.rs      (Create algorithm from config)
